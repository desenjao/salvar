generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PacientePrevenda {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String
  mensagem    String?
  genero      String
  idade       String
  desafio     String
  energia     String
  compromisso String
  userAgent   String?
  origem      String?
  pagina      String   @default("quiz")
  status      String   @default("prevenda")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}